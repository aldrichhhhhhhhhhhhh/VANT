{
  "rewrites": [
    {
      "source": "/mote-exe",
      "destination": "/"
    },
    {
      "source": "/mote-exe/:path*",
      "destination": "/"
    },
    {
      "source": "/privacy",
      "destination": "/"
    },
    {
      "source": "/terms",
      "destination": "/"
    },
    {
      "source": "/libraries",
      "destination": "/"
    },
    {
      "source": "/connect",
      "destination": "/"
    },
    {
      "source": "/contact",
      "destination": "/"
    },
    {
      "source": "/support",
      "destination": "/"
    },
    {
      "source": "/news",
      "destination": "/"
    },
    {
      "source": "/research",
      "destination": "/"
    },
    {
      "source": "/policy",
      "destination": "/"
    },
    {
      "source": "/commitments",
      "destination": "/"
    },
    {
      "source": "/company",
      "destination": "/"
    },
    {
      "source": "/products",
      "destination": "/"
    },
    {
      "source": "/perspectives",
      "destination": "/"
    },
    {
      "source": "/our-approach",
      "destination": "/"
    },
    {
      "source": "/mission",
      "destination": "/"
    },
    {
      "source": "/vision",
      "destination": "/"
    },
    {
      "source": "/partnerships",
      "destination": "/"
    },
    {
      "source": "/education",
      "destination": "/"
    },
    {
      "source": "/about-us",
      "destination": "/"
    },
    {
      "source": "/company-story",
      "destination": "/"
    },
    {
      "source": "/company-profile",
      "destination": "/"
    },
    {
      "source": "/business-theory",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
